# ---------------------------------------------------------------------------
# Variables de entorno de North Trade
#
# 1. Copiá este archivo como ".env.local" (ese archivo NUNCA se sube a git).
# 2. Completá los valores reales.
# 3. En Vercel, cargá las mismas variables en Project > Settings > Environment Variables.
#
# Las variables que empiezan con NEXT_PUBLIC_ son visibles en el navegador:
# nunca pongas claves secretas en ellas.
# Las variables se irán agregando a medida que avancen las etapas.
# ---------------------------------------------------------------------------

# Dirección pública del sitio, sin barra final. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo para revisar antes del lanzamiento: con "1", el sitio pide a Google y a los demás
# buscadores no indexarlo. Quitarla (o dejarla vacía) al publicar en el dominio real.
BLOQUEAR_BUSCADORES=

# --- Sanity (panel de carga de propiedades) -------------------------------
# Datos públicos del proyecto: están en https://www.sanity.io/manage
# (proyecto "North Trade" > Project ID). No son secretos.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Conjunto de datos. Dejar "production" salvo que se indique otra cosa.
NEXT_PUBLIC_SANITY_DATASET=production

# SECRETO. Clave del webhook que avisa al sitio cuando se publica un cambio.
# Inventar una frase larga al azar y cargar la MISMA en Sanity:
# sanity.io/manage > API > Webhooks > Create webhook
#   URL: https://www.northtrade.com.ar/api/revalidate · Dataset: production
#   Trigger on: Create, Update, Delete · Filter: _type == "property"
#   Projection: {_type} · Secret: el mismo valor de abajo.
# Cargarla también en Vercel. Sin ella, los cambios igual aparecen, con hasta una hora de demora.
SANITY_REVALIDATE_SECRET=

# SECRETO. Clave con permiso de escritura, solo para la migración (npm run migrar).
# Se crea en sanity.io/manage > API > Tokens > Add API token (permiso "Editor").
# NO cargarla en Vercel: el sitio no la necesita. Borrarla de Sanity al terminar.
SANITY_API_WRITE_TOKEN=

# --- Formulario de contacto -------------------------------------------------
# Si falta cualquiera de estas variables, el formulario no se muestra y la página
# de contacto ofrece solo WhatsApp y teléfono.

# SECRETO. Resend envía los mails del formulario. resend.com > API Keys > Create
# (permiso "Sending access").
RESEND_API_KEY=
# Remitente. Para usar @northtrade.com.ar hay que verificar el dominio en Resend
# (Resend > Domains): eso agrega registros DNS y lo hace el dueño del dominio.
# Para probar antes de verificarlo: "North Trade <onboarding@resend.dev>"
# (solo envía al correo con el que se creó la cuenta de Resend).
# Ya verificado el dominio: "North Trade <web@northtrade.com.ar>"
CONTACT_FROM_EMAIL=
# Correo que recibe las consultas. Las respuestas van directo a quien escribió.
CONTACT_TO_EMAIL=

# Captcha de Cloudflare Turnstile (gratuito). dash.cloudflare.com > Turnstile > Add widget,
# con los dominios www.northtrade.com.ar, northtrade.com.ar y localhost.
# La clave de sitio es pública; la secreta, no.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRETO.
TURNSTILE_SECRET_KEY=
# Para probar en local sin cuenta, Cloudflare ofrece claves de prueba que siempre aprueban:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Límite de envíos por visita (5 por hora) con Upstash Redis (plan gratuito).
# console.upstash.com > Create database > pestaña "REST API": copiar URL y token.
UPSTASH_REDIS_REST_URL=
# SECRETO.
UPSTASH_REDIS_REST_TOKEN=
